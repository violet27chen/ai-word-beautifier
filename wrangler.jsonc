{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-word-beautifier",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "ai-word-admin",
      "database_id": "ebe512df-6df5-4ea1-8464-b83fa4d32ddb"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ai-word-beautifier"
    }
  ],
  "observability": {
    "enabled": true
  }
}
