# ============================================================
# AI Word 排版美化助手 - 环境变量配置文件
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env.local（本地开发）或在 CloudBase 控制台设置
#   2. 填入你的 API Key
#   3. 不要将此文件提交到 Git
# ============================================================

# ---------- AI 模型 API Keys ----------
# 智谱 AI (GLM)
ZHIPU_API_KEY=

# 月之暗面 (Kimi)
MOONSHOT_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# 豆包 (字节跳动)
DOUBAO_API_KEY=

# 通义千问 (阿里)
DASHSCOPE_API_KEY=

# MiMo (小米) - baseURL: https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=

# ---------- 搜索 API ----------
# Tavily 搜索（可配多个 Key 轮换）
MCP_SEARCH_ENDPOINT=https://api.tavily.com/search
MCP_API_KEY=
TAVILY_API_KEY=
TAVILY_API_KEY_2=
TAVILY_API_KEY_3=

# ---------- 管理后台 ----------
ADMIN_PASSWORD=

# ---------- 捐赠信息（可选） ----------
NEXT_PUBLIC_USDT_DONATION_NETWORK=TRC20
NEXT_PUBLIC_USDT_DONATION_ADDRESS=
